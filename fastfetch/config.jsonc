{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/pngs/fedoraart.txt",
    "color": {
      "1": "#FF0055"
    },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
      "color": "#FF0055"
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "#ff0055",
      "color": "#e0def4",
      "format": "Its Not Arch But... ''Fedora BTW''"
    },
    {
      "type": "host",
      "key": "🖥 ",
      "keyColor": "#ff0055",
      "color": "#e0def4",
      "format": "QPC"
    },
    {
      "type": "shell",
      "format": "NIGGA",
      "key": ">_",
      "keyColor": "#ff0055",
      "color": "#e0def4"
    },
    {
      "type": " ",
      "key": "TERMINAL ",
      "keyColor": "#ff0055",
      "color": "#e0def4"
    },
    {
      "type": "wm",
      "format": "{} (wayland)",
      "key": " ",
      "keyColor": "#ff0055",
      "color": "#e0def4"
    },
    {
      "type": "cpu",
      "key": "󰍛 ",
      "keyColor": "#ff0055",
      "color": "#e0def4",
      "format": "AMD Ryzen 5 5600"
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "keyColor": "#ff0055",
      "color": "#e0def4",
      "format": "NVIDIA GeForce RTX 5060"
    },
    {
      "type": "memory",
      "key": "🎟 ",
      "keyColor": "#ff0055",
      "color": "#e0def4",
      "format": "{} {}"
    },

    {
      "type": "uptime",
      "key": " ",
      "keyColor": "#ff0055",
      "color": "#e0def4"
    },

    "break",
    "break",
    "break"
  ]
}
